#!/usr/bin/env bash
#MISE description="Install a tool — from the package index or a local path"
#USAGE arg "<name>" help="Package name, optionally with ref (bare/@latest release, @main branch, @v1.0.0 tag)"
#USAGE arg "[path]" help="Local path to repo (optional — if omitted, clones from package index)"
#USAGE flag "--as <alias>" var=#true help="Command alias(es) — creates symlinks to the package shim"
#USAGE example "shiv install shimmer" header="Install the latest stable release"
#USAGE example "shiv install shimmer@main --as shimmer-dev" header="Track a branch under an alias"
set -euo pipefail

REPO_DIR="$MISE_CONFIG_ROOT"
source "$REPO_DIR/lib/shim.sh"
source "$REPO_DIR/lib/format.sh"

NAME="${usage_name}"
LOCAL_PATH="${usage_path:-}"
SEP='|'

# Parse name@ref syntax. Bare installs and @latest are release-channel
# installs; explicit branches/tags/commits preserve their requested intent.
REQUESTED_REF=""
REF=""
REF_TYPE=""
REF_MODE=""
if [[ "$NAME" == *@* ]]; then
  REQUESTED_REF="${NAME#*@}"
  NAME="${NAME%%@*}"
fi

# Collect aliases from --as flags (var=#true gives space-separated string)
ALIASES=()
if [ -n "${usage_as:-}" ]; then
  while IFS= read -r alias; do
    [ -z "$alias" ] || ALIASES+=("$alias")
  done < <(printf '%s' "$usage_as" | xargs printf '%s\n')
fi

if [ -n "$LOCAL_PATH" ]; then
  # Local install — point at an existing repo
  if [ -n "$REQUESTED_REF" ]; then
    echo "Error: @ref syntax is not supported with local path installs" >&2
    exit 1
  fi
  REF_MODE="local"
  TOOL_PATH="$(cd "$LOCAL_PATH" && pwd)"
else
  # Package install — look up in sources and clone
  if ! GH_REPO=$(shiv_lookup "$NAME"); then
    GH_REPO=""
  fi
  if [ -z "$GH_REPO" ]; then
    echo "" >&2
    echo "  ✗ '$NAME' not found in package index" >&2
    echo "" >&2

    # Show available packages as a table (deduplicated)
    available=$(shiv_list_sources | awk '!seen[$1]++ {printf "%s|%s\n", $1, $2}' | sort -t'|' -k1,1)

    if [ -n "$available" ]; then
      echo "$available" | gum table -s "$SEP" -c "PACKAGE,REPO" -p --border normal >&2
    fi
    exit 1
  fi

  # Resolve install intent. Bare installs and @latest use the newest stable
  # semver-ish release tag. Branch tracking is explicit: install name@main.
  if [ -z "$REQUESTED_REF" ] || [ "$REQUESTED_REF" = "latest" ]; then
    latest_status=0
    REF=$(shiv_latest_release_tag "$GH_REPO") || latest_status=$?
    if [ "$latest_status" -eq 1 ]; then
      echo "" >&2
      echo "  ✗ No release tags found for $NAME" >&2
      echo "    Use 'shiv install ${NAME}@main' to track the main branch," >&2
      echo "    or 'shiv install ${NAME}@<branch>' for another branch." >&2
      echo "" >&2
      exit 1
    elif [ "$latest_status" -ne 0 ]; then
      exit "$latest_status"
    fi
    REF_TYPE="tag"
    REF_MODE="release"
  else
    REF="$REQUESTED_REF"
    REF_TYPE=$(shiv_detect_ref_type "$GH_REPO" "$REF") || exit 1
    case "$REF_TYPE" in
      branch) REF_MODE="branch" ;;
      tag) REF_MODE="tag" ;;
      commit) REF_MODE="commit" ;;
    esac
  fi

  TOOL_PATH="$SHIV_PACKAGES_DIR/$NAME"

  # Existing release/tag clones may have narrow fetch refspecs. Fetch the
  # resolved ref explicitly before checkout, and never reset local branch
  # commits silently when switching to branch tracking.
  fetch_branch_ref() {
    local branch="$1"
    local refspec="+refs/heads/$branch:refs/remotes/origin/$branch"

    if ! git -C "$TOOL_PATH" config --get-all remote.origin.fetch | grep -qxF "$refspec"; then
      git -C "$TOOL_PATH" config --add remote.origin.fetch "$refspec"
    fi
    git -C "$TOOL_PATH" fetch origin "$refspec" 2>&1 | sed 's/^/  /'
  }

  checkout_branch_ref() {
    local branch="$1"
    local local_ahead escaped_tool_path

    if git -C "$TOOL_PATH" show-ref --verify --quiet "refs/heads/$branch"; then
      local_ahead=$(git -C "$TOOL_PATH" rev-list --count "origin/$branch..$branch" 2>/dev/null || echo "0")
      if [ "$local_ahead" -gt 0 ]; then
        printf -v escaped_tool_path '%q' "$TOOL_PATH"
        echo "  ✗ Refusing to switch $NAME to $branch: local branch $branch has commits not on origin/$branch." >&2
        echo "    shiv will not reset local commits in a managed package." >&2
        echo "" >&2
        echo "    Inspect:" >&2
        echo "      git -C $escaped_tool_path log --oneline origin/$branch..$branch" >&2
        echo "" >&2
        echo "    To discard manually:" >&2
        echo "      git -C $escaped_tool_path reset --hard origin/$branch" >&2
        exit 1
      fi
      git -C "$TOOL_PATH" checkout "$branch" 2>&1 | sed 's/^/  /'
    else
      git -C "$TOOL_PATH" checkout -b "$branch" "origin/$branch" 2>&1 | sed 's/^/  /'
    fi
    git -C "$TOOL_PATH" branch --set-upstream-to="origin/$branch" "$branch" 2>&1 | sed 's/^/  /'
  }

  # If already cloned but the resolved ref or intent changed, switch in-place
  # rather than deleting a directory we might be running from (e.g., shiv
  # reinstalling itself).
  if [ -d "$TOOL_PATH" ]; then
    EXISTING_REF=$(shiv_registry_ref "$NAME")
    EXISTING_MODE=$(shiv_registry_ref_mode "$NAME")
    CURRENT_BRANCH=$(git -C "$TOOL_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [ "$REF" != "$EXISTING_REF" ] || [ "$REF_MODE" != "$EXISTING_MODE" ]; then
      echo "  Ref changed (${EXISTING_MODE:-legacy}:${EXISTING_REF:-unknown} → ${REF_MODE}:${REF}), switching..."
      case "$REF_MODE" in
        release|tag)
          git -C "$TOOL_PATH" fetch --tags origin 2>&1 | sed 's/^/  /'
          ;;
        branch)
          fetch_branch_ref "$REF"
          ;;
        commit)
          git -C "$TOOL_PATH" fetch --depth 1 origin "$REF" 2>&1 | sed 's/^/  /'
          ;;
      esac
      if [ "$REF_MODE" = "branch" ]; then
        checkout_branch_ref "$REF"
      else
        # Release/tag/commit checkouts are intentionally detached; mute Git's
        # detached-HEAD advisory while still surfacing real checkout errors.
        git -C "$TOOL_PATH" -c advice.detachedHead=false checkout "$REF" 2>&1 | sed 's/^/  /'
      fi
    elif [ "$REF_MODE" = "branch" ] && [ "$REF" != "$CURRENT_BRANCH" ]; then
      echo "  Branch changed (${CURRENT_BRANCH:-detached} → ${REF}), switching..."
      fetch_branch_ref "$REF"
      checkout_branch_ref "$REF"
    fi
  fi

  if [ -d "$TOOL_PATH" ]; then
    echo "  Already cloned: $TOOL_PATH"
    case "$REF_MODE" in
      branch)
        gum spin --title "  Pulling latest from $REF..." --show-error -- git -C "$TOOL_PATH" pull --ff-only
        ;;
      release)
        echo "  Release $REF already installed — skipping pull"
        ;;
      tag|commit)
        echo "  Pinned to $REF — skipping pull"
        ;;
    esac
  else
    mkdir -p "$SHIV_PACKAGES_DIR"
    CLONE_URL="https://github.com/$GH_REPO.git"
    case "$REF_TYPE" in
      branch)
        gum spin --title "  Cloning $GH_REPO@$REF..." --show-error -- git clone --branch "$REF" --single-branch "$CLONE_URL" "$TOOL_PATH"
        ;;
      tag)
        # `clone --branch <tag>` emits "warning: refs/tags/X is not a commit!" for
        # annotated/signed tags. Clone the default branch, then fetch the tag
        # explicitly (creates the local tag ref that list/describe rely on) and
        # check it out; suppress the detached-HEAD advisory.
        gum spin --title "  Cloning $GH_REPO@$REF..." --show-error -- git clone --depth 1 --single-branch "$CLONE_URL" "$TOOL_PATH"
        git -C "$TOOL_PATH" fetch --depth 1 origin tag "$REF" 2>&1 | sed 's/^/  /'
        git -C "$TOOL_PATH" -c advice.detachedHead=false checkout "$REF" 2>&1 | sed 's/^/  /'
        ;;
      commit)
        gum spin --title "  Cloning $GH_REPO@$REF..." --show-error -- git clone --depth 1 --single-branch "$CLONE_URL" "$TOOL_PATH"
        git -C "$TOOL_PATH" fetch --depth 1 origin "$REF" 2>&1 | sed 's/^/  /'
        # Commit checkout is intentionally detached — suppress the advisory.
        git -C "$TOOL_PATH" -c advice.detachedHead=false checkout "$REF" 2>&1 | sed 's/^/  /'
        ;;
    esac
  fi

fi

if [ -f "$TOOL_PATH/mise.toml" ]; then
  # Set up dependencies after resolving TOOL_PATH so both package installs and
  # local path installs trust/install the tool repo before shim creation.
  printf -v escaped_path '%q' "$TOOL_PATH"
  dep_output=$(gum spin --title "  Setting up dependencies..." -- bash -c "cd $escaped_path && unset MISE_OVERRIDE_CONFIG_FILENAMES && mise trust -q 2>&1 && mise install -q 2>&1") || {
    echo "  ✗ Failed to install dependencies for $NAME" >&2
    echo "$dep_output" | strip_ansi | sed 's/^/    /' >&2
    exit 1
  }
else
  echo "  ⚠ No mise.toml found at $TOOL_PATH"
fi

# Task discovery proves the package can run before any durable state is written.
# Failing here matches the dependency-setup path above: the clone stays for a
# retry, but nothing is registered or shimmed.
if ! discovery_error=$(shiv_package_tasks_discoverable "$TOOL_PATH"); then
  echo "  ✗ Failed to read tasks for $NAME" >&2
  echo "$discovery_error" | strip_ansi | sed 's/^/    /' >&2
  exit 1
fi

shiv_create_shim "$NAME" "$TOOL_PATH"
if [ -n "${usage_as:-}" ]; then
  SHIV_REF="$REF" SHIV_REF_MODE="$REF_MODE" shiv_register "$NAME" "$TOOL_PATH" ${ALIASES[@]+"${ALIASES[@]}"}
else
  SHIV_REF="$REF" SHIV_REF_MODE="$REF_MODE" shiv_register "$NAME" "$TOOL_PATH"
fi
shiv_cache_tasks "$NAME" "$TOOL_PATH"
shiv_cache_task_map "$NAME" "$TOOL_PATH"

# Create alias symlinks
if [ -n "${usage_as:-}" ]; then
  shiv_create_alias_symlinks "$NAME" ${ALIASES[@]+"${ALIASES[@]}"}
fi

# --- Summary card ---
echo ""
echo "  ✓ Installed $NAME${REF:+@$REF}"
echo ""

# Gather git metadata
branch="-"
version="-"
if [ -d "$TOOL_PATH/.git" ]; then
  branch=$(git -C "$TOOL_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
  short=$(git -C "$TOOL_PATH" rev-parse --short HEAD 2>/dev/null || echo "-")
  tag=$(git -C "$TOOL_PATH" describe --tags --exact-match HEAD 2>/dev/null || echo "")
  version="${tag:-$short}"
  if [ -n "$(git -C "$TOOL_PATH" status --porcelain 2>/dev/null | head -1)" ]; then
    version="${version}*"
  fi
fi

# Gather available tasks from cache
tasks="-"
task_count=0
tasks_truncated=false
MAX_TASK_GROUPS=8
cache_file="$SHIV_CACHE_DIR/completions/$NAME.cache"
if [ -f "$cache_file" ]; then
  # Count total tasks (excluding internal ones)
  task_count=$(awk -F'\t' '$1 != "" && $1 != "mise-config" && $1 != "zshrc"' "$cache_file" | wc -l | tr -d ' ')

  if [ "$task_count" -gt 0 ]; then
    # Group by top-level prefix (before ':'), count each group
    # Standalone tasks (no ':') are listed individually
    all_groups=$(awk -F'\t' '$1 != "" && $1 != "mise-config" && $1 != "zshrc" {print $1}' "$cache_file" \
      | awk -F: '{
          if (NF > 1) groups[$1]++
          else standalone[$1]=1
        }
        END {
          for (g in groups) printf "%s (%d)\n", g, groups[g]
          for (s in standalone) printf "%s\n", s
        }' \
      | sort)

    total_groups=$(echo "$all_groups" | wc -l | tr -d ' ')

    if [ "$total_groups" -gt "$MAX_TASK_GROUPS" ]; then
      tasks=$(echo "$all_groups" | head -n "$MAX_TASK_GROUPS" | paste -sd, - | sed 's/,/, /g')
      tasks="${tasks}, ..."
      tasks_truncated=true
    else
      tasks=$(echo "$all_groups" | paste -sd, - | sed 's/,/, /g')
    fi
  fi
fi

# Format aliases
alias_display="-"
if [ "${#ALIASES[@]}" -gt 0 ]; then
  alias_display="$(printf '%s\n' ${ALIASES[@]+"${ALIASES[@]}"} | paste -sd' ' -)"
fi

# Build summary card as key-value table
{
  echo "PACKAGE${SEP}${NAME}"
  echo "PATH${SEP}${TOOL_PATH}"
  echo "BRANCH${SEP}${branch}"
  echo "VERSION${SEP}${version}"
  echo "SHIM${SEP}${SHIV_BIN_DIR}/${NAME}"
  echo "ALIASES${SEP}${alias_display}"
  if [ "$task_count" -gt 0 ]; then
    echo "TASKS (${task_count})${SEP}${tasks}"
  else
    echo "TASKS${SEP}-"
  fi
} | gum table -s "$SEP" -c "KEY,VALUE" -p --border normal

if [ "$tasks_truncated" = "true" ]; then
  gum style --faint "  Run '$NAME tasks' to see all $task_count tasks."
fi
