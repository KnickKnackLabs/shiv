#!/usr/bin/env bash
#MISE description="Check health of all managed tools"
set -eo pipefail

REPO_DIR="$MISE_CONFIG_ROOT"
source "$REPO_DIR/lib/shim.sh"

shiv_init_registry

SEP='|'
HAS_ISSUES=false

reinstall_spec() {
  local name="$1" ref mode
  ref=$(shiv_registry_ref "$name")
  mode=$(shiv_registry_ref_mode "$name")

  case "$mode" in
    branch | tag | commit)
      if [ -n "$ref" ]; then
        printf '%s@%s\n' "$name" "$ref"
      else
        printf '%s\n' "$name"
      fi
      ;;
    *)
      printf '%s\n' "$name"
      ;;
  esac
}

recovery_guidance() {
  local name="$1" repo="$2" repo_usable="$3" generated_issue="$4" shim_conflict="$5"
  local mode spec

  if [ "$repo_usable" = "true" ]; then
    if [ "$shim_conflict" = "true" ]; then
      echo "    → Inspect or move the conflicting shim, then run 'shiv reshim'"
    elif [ "$generated_issue" = "true" ]; then
      echo "    → Repair generated artifacts with: shiv reshim"
    fi
    return 0
  fi

  mode=$(shiv_registry_ref_mode "$name")
  if [ "$mode" = "local" ]; then
    echo "    → Restore the local repository at $repo, or run 'shiv uninstall $name'"
  elif shiv_lookup "$name" >/dev/null 2>&1; then
    spec=$(reinstall_spec "$name")
    echo "    → Reinstall the missing repository with: shiv install $spec"
  else
    echo "    ⚠ Package not found in any source index"
    echo "    → Remove the stale registration with: shiv uninstall $name"
  fi
}

# ── Header ──────────────────────────────────────────────────────

COUNT=$(jq 'length' "$SHIV_REGISTRY")

# Schema validation
schema_status="✓ valid ($COUNT packages)"
if mise which jsonschema &>/dev/null; then
  if ! mise x -- jsonschema validate "$REPO_DIR/registry.schema.json" "$SHIV_REGISTRY" 2>/dev/null; then
    schema_status="✗ invalid — run 'shiv registry:validate'"
    HAS_ISSUES=true
  fi
else
  schema_status="- skipped (jsonschema not found)"
fi

# Bin dir check
bin_status="✓ $SHIV_BIN_DIR"
if [ ! -d "$SHIV_BIN_DIR" ]; then
  bin_status="✗ $SHIV_BIN_DIR (not found)"
  HAS_ISSUES=true
fi

echo ""
gum style --bold "  SHIV HEALTH"
echo ""
{
  echo "Registry${SEP}${schema_status}"
  echo "Bin dir${SEP}${bin_status}"
} | gum table -s "$SEP" -c "CHECK,STATUS" -p --border normal

# ── Per-package checks ──────────────────────────────────────────

if [ "$COUNT" -eq 0 ]; then
  echo ""
  echo "  No tools registered."
else
  echo ""
  gum style --bold "  PACKAGES"
  echo ""

  rows=()
  issue_names=()
  issue_details=()

  while IFS=$'\t' read -r name repo _ref; do
    issues=""
    issue_count=0
    repo_usable=true
    generated_issue=false
    shim_conflict=false

    if [ ! -d "$repo" ]; then
      issues+="    ✗ repo not found at $repo"$'\n'
      issue_count=$((issue_count + 1))
      repo_usable=false
    elif ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      issues+="    ✗ repo is not a Git worktree at $repo"$'\n'
      issue_count=$((issue_count + 1))
      repo_usable=false
    fi

    if [ ! -f "$SHIV_BIN_DIR/$name" ]; then
      issues+="    ✗ shim missing at $SHIV_BIN_DIR/$name"$'\n'
      issue_count=$((issue_count + 1))
      generated_issue=true
    elif ! grep -q "# managed by shiv" "$SHIV_BIN_DIR/$name" 2>/dev/null; then
      issues+="    ✗ shim exists but not managed by shiv"$'\n'
      issue_count=$((issue_count + 1))
      shim_conflict=true
    fi

    if [ -f "$SHIV_BIN_DIR/$name" ]; then
      shim_repo=""
      if ! shim_repo=$(shiv_read_generated_repo "$SHIV_BIN_DIR/$name"); then
        shim_repo=""
      fi
      if [ -n "$shim_repo" ] && [ "$shim_repo" != "$repo" ]; then
        issues+="    ✗ shim points to $shim_repo but registry says $repo"$'\n'
        issue_count=$((issue_count + 1))
        generated_issue=true
      fi
    fi

    aliases=()
    while IFS= read -r _alias; do
      [ -n "$_alias" ] && aliases+=("$_alias")
    done < <(shiv_registry_aliases "$name")
    for alias in "${aliases[@]}"; do
      if [ ! -L "$SHIV_BIN_DIR/$alias" ]; then
        issues+="    ✗ alias symlink missing at $SHIV_BIN_DIR/$alias"$'\n'
        issue_count=$((issue_count + 1))
        generated_issue=true
      elif [ "$(readlink "$SHIV_BIN_DIR/$alias")" != "$name" ]; then
        issues+="    ✗ alias symlink $alias points to wrong target"$'\n'
        issue_count=$((issue_count + 1))
        generated_issue=true
      fi
    done

    if [ "$issue_count" -gt 0 ]; then
      guidance=$(recovery_guidance \
        "$name" "$repo" "$repo_usable" "$generated_issue" "$shim_conflict")
      if [ -n "$guidance" ]; then
        issues+="$guidance"$'\n'
      fi
    fi

    if [ "$issue_count" -gt 0 ]; then
      rows+=("${name}${SEP}✗ (${issue_count})")
      issue_names+=("$name")
      issue_details+=("$issues")
      HAS_ISSUES=true
    else
      rows+=("${name}${SEP}✓")
    fi
  done < <(shiv_registry_entries)

  # Package table
  printf '%s\n' "${rows[@]}" | gum table -s "$SEP" -c "PACKAGE,STATUS" -p --border normal

  # Issue details
  if [ ${#issue_names[@]} -gt 0 ]; then
    echo ""
    for i in "${!issue_names[@]}"; do
      gum style --bold "  ${issue_names[$i]}:"
      printf '%s' "${issue_details[$i]}"
    done
  fi
fi

# ── Orphaned shims ────────────────────────────────────────────

orphaned=()
if [ -d "$SHIV_BIN_DIR" ]; then
  for shim in "$SHIV_BIN_DIR"/*; do
    [ -f "$shim" ] || continue
    [ -L "$shim" ] && continue
    grep -q "# managed by shiv" "$shim" 2>/dev/null || continue
    shim_name=$(basename "$shim")
    # Skip if registered
    if jq -e --arg n "$shim_name" 'has($n)' "$SHIV_REGISTRY" &>/dev/null; then
      continue
    fi
    orphaned+=("$shim_name")
  done
fi

if [ ${#orphaned[@]} -gt 0 ]; then
  echo ""
  gum style --bold "  ORPHANED SHIMS"
  echo ""
  for name in "${orphaned[@]}"; do
    echo "    ✗ $SHIV_BIN_DIR/$name"
  done
  echo ""
  gum style --faint "  These shims reference shiv but have no registry entry."
  gum style --faint "  Remove with: rm \$shim_path"
  HAS_ISSUES=true
fi

if [ "$HAS_ISSUES" = "true" ]; then
  exit 1
fi
