#!/usr/bin/env bash
#MISE description="Run BATS tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="Test suites or BATS arguments"
#USAGE example "mise run test" header="Run default suites with measured parallelism"
#USAGE example "mise run test doctor" header="Run a specific suite by name"
#USAGE example "mise run test --filter rejects" header="Filter tests by name"
#USAGE example "mise run test --jobs 1" header="Run serially for debugging"
set -euo pipefail

# KKL BATS and Rush schedule isolated tests across and within files. The
# completion suite remains separate from the default test path.

test_directory="$MISE_CONFIG_ROOT/test"
default_parallel_jobs=8
excluded_default_suite="completions"
bats_command="${BATS_COMMAND:-bats}"
default_parallel_command="${RUSH_COMMAND:-rush}"

resolved_arguments=()
has_test_target=false
cli_jobs=""
cli_parallel_command=""

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 2
}

command_available() {
  case "$1" in
    */*) [ -x "$1" ] ;;
    *) command -v "$1" >/dev/null 2>&1 ;;
  esac
}

option_value_kind() {
  case "$1" in
    -j|--jobs) printf 'jobs\n' ;;
    --parallel-binary-name) printf 'parallel-command\n' ;;
    --code-quote-style|--line-reference-format|-f|--filter|--negative-filter|\
      --filter-status|--filter-tags|-F|--formatter|\
      --gather-test-outputs-in|--report-formatter|-o|--output)
      printf 'bats-option\n'
      ;;
    *) return 1 ;;
  esac
}

append_test_target() {
  local argument="$1"

  if [[ "$argument" != *.bats && -f "$test_directory/$argument.bats" ]]; then
    argument="$test_directory/$argument.bats"
  fi

  resolved_arguments+=("$argument")
  if [[ "$argument" == *.bats || -d "$argument" ]]; then
    has_test_target=true
  fi
}

resolve_arguments() {
  local argument value_kind pending_value_kind=""

  for argument in ${@+"$@"}; do
    if [ -n "$pending_value_kind" ]; then
      resolved_arguments+=("$argument")
      case "$pending_value_kind" in
        jobs) cli_jobs="$argument" ;;
        parallel-command) cli_parallel_command="$argument" ;;
      esac
      pending_value_kind=""
      continue
    fi

    if value_kind="$(option_value_kind "$argument")"; then
      resolved_arguments+=("$argument")
      pending_value_kind="$value_kind"
      continue
    fi

    case "$argument" in
      --no-parallelize-across-files)
        resolved_arguments+=("$argument")
        explicit_no_across=true
        ;;
      -*) resolved_arguments+=("$argument") ;;
      *) append_test_target "$argument" ;;
    esac
  done

  case "$pending_value_kind" in
    jobs) fail "--jobs requires a positive integer" ;;
    parallel-command) fail "--parallel-binary-name requires a command" ;;
    bats-option) fail "the final BATS option requires a value" ;;
  esac
}

append_default_targets() {
  local test_file

  if $has_test_target; then
    return
  fi

  for test_file in "$test_directory"/*.bats; do
    if [ "$(basename "$test_file" .bats)" = "$excluded_default_suite" ]; then
      continue
    fi
    resolved_arguments+=("$test_file")
  done
}

select_parallelism() {
  if [ -n "$cli_jobs" ]; then
    effective_jobs="$cli_jobs"
  elif [ -n "${BATS_NUMBER_OF_PARALLEL_JOBS:-}" ]; then
    effective_jobs="$BATS_NUMBER_OF_PARALLEL_JOBS"
  else
    effective_jobs="$default_parallel_jobs"
    export BATS_NUMBER_OF_PARALLEL_JOBS="$effective_jobs"
  fi

  [[ "$effective_jobs" =~ ^[1-9][0-9]*$ ]] ||
    fail "BATS parallel jobs must be a positive integer, got '$effective_jobs'."

  if [ -n "$cli_parallel_command" ]; then
    effective_parallel_command="$cli_parallel_command"
  elif [ -n "${BATS_PARALLEL_BINARY_NAME:-}" ]; then
    effective_parallel_command="$BATS_PARALLEL_BINARY_NAME"
  else
    effective_parallel_command="$default_parallel_command"
    export BATS_PARALLEL_BINARY_NAME="$effective_parallel_command"
  fi
}

contains_whitespace() {
  case "$1" in
    *[[:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

explicit_no_across=false

apply_parallel_transport_fallback() {
  local argument
  [ "$effective_jobs" -gt 1 ] || return 0
  $explicit_no_across && return 0
  if contains_whitespace "$MISE_CONFIG_ROOT"; then
    resolved_arguments=(--no-parallelize-across-files ${resolved_arguments[@]+"${resolved_arguments[@]}"})
    return 0
  fi
  for argument in ${resolved_arguments[@]+"${resolved_arguments[@]}"}; do
    if contains_whitespace "$argument"; then
      resolved_arguments=(--no-parallelize-across-files ${resolved_arguments[@]+"${resolved_arguments[@]}"})
      return 0
    fi
  done
}

require_commands() {
  if ! command_available "$bats_command"; then
    printf "Error: BATS executable '%s' is unavailable; run 'mise install'.\n" \
      "$bats_command" >&2
    exit 127
  fi

  if [ "$effective_jobs" -gt 1 ] &&
      ! command_available "$effective_parallel_command"; then
    printf "Error: BATS parallel runner '%s' is unavailable for %s jobs; run 'mise install' or use --jobs 1.\n" \
      "$effective_parallel_command" "$effective_jobs" >&2
    exit 127
  fi
}

run_bats() {
  local bats_arguments=(--print-output-on-failure)

  if [ "$effective_jobs" -gt 1 ]; then
    printf 'BATS parallelism: %s jobs across and within isolated suites via %s\n' \
      "$effective_jobs" "$effective_parallel_command" >&2
  else
    printf 'BATS parallelism: serial\n' >&2
  fi

  bats_arguments+=(${resolved_arguments[@]+"${resolved_arguments[@]}"})
  if [ -n "${BATS_COMMAND:-}" ]; then
    exec "$BATS_COMMAND" ${bats_arguments[@]+"${bats_arguments[@]}"}
  else
    exec bats ${bats_arguments[@]+"${bats_arguments[@]}"}
  fi
}

arguments=()
if [ -n "${usage_args:-}" ]; then
  while IFS= read -r argument; do
    [ -z "$argument" ] || arguments+=("$argument")
  done < <(printf '%s' "$usage_args" | xargs printf '%s\n')
fi

resolve_arguments ${arguments[@]+"${arguments[@]}"}
append_default_targets
select_parallelism
apply_parallel_transport_fallback
require_commands
run_bats
