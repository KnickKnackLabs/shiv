#!/usr/bin/env bash
#MISE description="Print the install path of a managed tool"
#USAGE arg "<name>" help="Package name or alias to look up"
#USAGE example "shiv which shimmer" header="Print a package checkout path"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/shim.sh"

shiv_help_guard "$@"

NAME="${usage_name}"
CALLER_DIR="${SHIV_CALLER_PWD:-${CALLER_PWD:-${MISE_ORIGINAL_CWD:-$PWD}}}"
shiv_init_registry

PATH_VAL=""
if PATH_VAL=$(shiv_mise_scoped_package_path "$NAME" "$CALLER_DIR"); then
  :
elif PATH_VAL=$(shiv_global_package_path "$NAME"); then
  :
else
  echo "shiv: '$NAME' is not a managed tool" >&2
  echo "Run 'shiv list' to see managed tools." >&2
  exit 1
fi

echo "$PATH_VAL"
